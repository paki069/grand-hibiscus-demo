# Copy to .env.local for local development. NEVER commit real values.

# --- Supabase (required) ---
# Local Supabase CLI defaults are shown; use your project values on Vercel.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Used for creating staff accounts, the outbox and cron jobs.
# Never prefix with NEXT_PUBLIC_ and never import it from client components.
SUPABASE_SERVICE_ROLE_KEY=

# SERVER ONLY. Numeric code required to immediately approve admin signups.
# Use a long, unique code; never prefix with NEXT_PUBLIC_ or share it in client code.
ADMIN_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# --- Petal AI (server only; required for live chat and voice features) ---
# Create a Groq API key and set a chat model available to that key.
GROQ_API_KEY=
GROQ_MODEL=

# --- Outgoing app email (optional). Copy your SMTP provider settings here. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=verified-sender@example.com
SMTP_PASS=
EMAIL_FROM=The Grand Hibiscus

# --- Cron (optional). Protects /api/cron/maintenance (Vercel Cron sends it as a Bearer token). ---
CRON_SECRET=

# Local development only. Used by `npm run seed:users`; never reuse a real account password.
DEMO_PASSWORD=

# --- Payments ---
# Local-only test gateway: exact matching values approve a simulated payment; never use real card data.
# These values are read only by the server and are never saved with a booking.
CARD_NUM=
CARD_EXP=
CARD_CVC=
# Development-only fake payment: requires BOTH this flag and the admin setting. Never enable in production.
ALLOW_DEV_PAYMENTS=false
